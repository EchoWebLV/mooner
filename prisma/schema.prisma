generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  description  String
  telegramLink String?
  twitterLink  String?
  websiteLink  String?
  postName     String
  ticker       String
  CA           String   @unique
  image        String?
  createdAt    DateTime @default(now())
}