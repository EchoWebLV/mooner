generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  description String
  links       String[]
  postName    String
  ticker      String
  image       String?  // Optional field for image URL
  createdAt   DateTime @default(now())
}